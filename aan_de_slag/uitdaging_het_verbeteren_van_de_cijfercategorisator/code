function getGrade(grade) {
  if (grade >= 90) {
    console.log("Grade: A");
  } else if (grade >= 80) {
    console.log("Grade: B");
  } else if (grade >= 70) {
    console.log("Grade: C");
  } else if (grade >= 60) {
    console.log("Grade: D");
  } else {
    console.log("Grade: F");
  }
}

getGrade(30);
getGrade(50);
getGrade(70);
getGrade(97);